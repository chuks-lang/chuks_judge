// ─── chuks_judge/report ─────────────────────────────────────────────────────
// EvalReport, RegressionReport, and ComparisonReport with analysis methods.
// ─────────────────────────────────────────────────────────────────────────────

import { json } from "std/json"
import { fs } from "std/fs"
import { math } from "std/math"
import { EvalResult, DimReport, PairwiseResult } from "./types"

// ─── RegressionReport ───────────────────────────────────────────────────────

export class RegressionReport {
    var baselineName: string
    var passRateDelta: float
    var scoreDelta: float
    var regressions: []any
    var improvements: []any
    var stable: []any
    var isRegression: bool

    constructor() {
        this.baselineName = ""
        this.passRateDelta = 0.0
        this.scoreDelta = 0.0
        this.regressions = []
        this.improvements = []
        this.stable = []
        this.isRegression = false
    }
}

// ─── ComparisonReport ───────────────────────────────────────────────────────

export class ComparisonReport {
    var winner: string
    var aWinRate: float
    var bWinRate: float
    var tieRate: float
    var avgScoreA: float
    var avgScoreB: float
    var improvement: float
    var cases: []any

    constructor() {
        this.winner = "tie"
        this.aWinRate = 0.0
        this.bWinRate = 0.0
        this.tieRate = 0.0
        this.avgScoreA = 0.0
        this.avgScoreB = 0.0
        this.improvement = 0.0
        this.cases = []
    }
}

// ─── EvalReport ─────────────────────────────────────────────────────────────

export class EvalReport {
    var totalCases: int
    var passed: int
    var failed: int
    var passRate: float
    var avgScore: float
    var medianScore: float
    var stdDev: float
    var dimensions: []any
    var totalTokens: int
    var totalCost: float
    var durationMs: int
    var casesPerSec: float
    var results: []any

    constructor() {
        this.totalCases = 0
        this.passed = 0
        this.failed = 0
        this.passRate = 0.0
        this.avgScore = 0.0
        this.medianScore = 0.0
        this.stdDev = 0.0
        this.dimensions = []
        this.totalTokens = 0
        this.totalCost = 0.0
        this.durationMs = 0
        this.casesPerSec = 0.0
        this.results = []
    }

    // buildFromResults computes all aggregate metrics from a list of EvalResult
    buildFromResults(evalResults: []any, durationMs: int): void {
        this.results = evalResults
        this.totalCases = evalResults.length
        this.durationMs = durationMs

        if (this.totalCases == 0) {
            return
        }

        var sumScore: float = 0.0
        var passCount: int = 0
        var tokenSum: int = 0
        var costSum: float = 0.0
        var scores: []any = []

        for (var i: int = 0; i < evalResults.length; i = i + 1) {
            var r: any = evalResults[i]
            sumScore = sumScore + r.score
            tokenSum = tokenSum + r.tokens
            costSum = costSum + r.cost
            scores.push(r.score)
            if (r.passed) {
                passCount = passCount + 1
            }
        }

        this.passed = passCount
        this.failed = this.totalCases - passCount
        this.avgScore = sumScore / float(this.totalCases)
        this.passRate = (float(passCount) / float(this.totalCases)) * 100.0
        this.totalTokens = tokenSum
        this.totalCost = costSum

        if (durationMs > 0) {
            this.casesPerSec = float(this.totalCases) / (float(durationMs) / 1000.0)
        }

        // Median — sort scores and pick middle
        this.medianScore = computeMedian(scores)

        // Standard deviation
        this.stdDev = computeStdDev(scores, this.avgScore)
    }

    // filter returns results matching a predicate
    filter(fn: any): []any {
        var out: []any = []
        for (var i: int = 0; i < this.results.length; i = i + 1) {
            if (fn(this.results[i])) {
                out.push(this.results[i])
            }
        }
        return out
    }

    // groupBy groups results by a field name (category, etc.)
    //
    // Note: a value fetched from a map via `.get` is a copy under the AOT
    // backend, so mutating it in place does not persist. We accumulate each
    // group into a fresh `[]any` and only `.set` the finished group back into
    // the map once, which behaves identically under the VM and AOT backends.
    groupBy(key: string): map[string]any {
        var keys: []string = []
        var buckets: [][]any = []

        for (var i: int = 0; i < this.results.length; i = i + 1) {
            var r: any = this.results[i]
            var groupKey: string = ""
            if (key == "category") {
                groupKey = string(r.category)
            } else if (key == "judgeModel") {
                groupKey = string(r.judgeModel)
            } else {
                groupKey = "unknown"
            }
            if (groupKey == "") {
                groupKey = "uncategorized"
            }

            var bi: int = -1
            for (var k: int = 0; k < keys.length; k = k + 1) {
                if (keys[k] == groupKey) {
                    bi = k
                    break
                }
            }
            if (bi < 0) {
                keys.push(groupKey)
                var fresh: []any = []
                buckets.push(fresh)
                bi = keys.length - 1
            }
            buckets[bi].push(r)
        }

        var groups: map[string]any = {}
        for (var g: int = 0; g < keys.length; g = g + 1) {
            var gResults: []any = buckets[g]
            var gPassed: int = 0
            var gSum: float = 0.0
            for (var j: int = 0; j < gResults.length; j = j + 1) {
                gSum = gSum + gResults[j].score
                if (gResults[j].passed) {
                    gPassed = gPassed + 1
                }
            }
            var passRate: float = 0.0
            var avgScore: float = 0.0
            if (gResults.length > 0) {
                passRate = (float(gPassed) / float(gResults.length)) * 100.0
                avgScore = gSum / float(gResults.length)
            }
            groups.set(keys[g], { "results": gResults, "passRate": passRate, "avgScore": avgScore })
        }

        return groups
    }

    // top returns the N highest-scoring results
    top(n: int): []any {
        var sorted: []any = sortByScore(this.results, false)
        if (n > sorted.length) {
            n = sorted.length
        }
        var out: []any = []
        for (var i: int = 0; i < n; i = i + 1) {
            out.push(sorted[i])
        }
        return out
    }

    // bottom returns the N lowest-scoring results
    bottom(n: int): []any {
        var sorted: []any = sortByScore(this.results, true)
        if (n > sorted.length) {
            n = sorted.length
        }
        var out: []any = []
        for (var i: int = 0; i < n; i = i + 1) {
            out.push(sorted[i])
        }
        return out
    }

    // withTag filters to results that have a specific tag
    withTag(tag: string): EvalReport {
        var filtered: []any = []
        for (var i: int = 0; i < this.results.length; i = i + 1) {
            var r: any = this.results[i]
            var tags: []any = r.tags
            for (var j: int = 0; j < tags.length; j = j + 1) {
                if (tags[j] == tag) {
                    filtered.push(r)
                    break
                }
            }
        }
        var sub: EvalReport = new EvalReport()
        sub.buildFromResults(filtered, this.durationMs)
        return sub
    }

    // ── Export Methods ───────────────────────────────────────────────────

    // toJSON writes the report as JSON to a file
    async toJSON(filepath: string): Task<any> {
        var data: any = {
            "totalCases": this.totalCases,
            "passed": this.passed,
            "failed": this.failed,
            "passRate": this.passRate,
            "avgScore": this.avgScore,
            "medianScore": this.medianScore,
            "stdDev": this.stdDev,
            "totalTokens": this.totalTokens,
            "totalCost": this.totalCost,
            "durationMs": this.durationMs,
            "casesPerSec": this.casesPerSec,
            "results": this.results,
        }
        fs.writeFile(filepath, json.stringify(data))
        return null
    }

    // toMarkdown returns a markdown summary string
    toMarkdown(): string {
        var md: string = "# Evaluation Report\n\n"
        md = md + "| Metric | Value |\n|---|---|\n"
        md = md + "| Total Cases | " + string(this.totalCases) + " |\n"
        md = md + "| Passed | " + string(this.passed) + " |\n"
        md = md + "| Failed | " + string(this.failed) + " |\n"
        md = md + "| Pass Rate | " + string(this.passRate) + "% |\n"
        md = md + "| Avg Score | " + string(this.avgScore) + " |\n"
        md = md + "| Median Score | " + string(this.medianScore) + " |\n"
        md = md + "| Std Dev | " + string(this.stdDev) + " |\n"
        md = md + "| Total Tokens | " + string(this.totalTokens) + " |\n"
        md = md + "| Total Cost | $" + string(this.totalCost) + " |\n"
        md = md + "| Duration | " + string(this.durationMs) + "ms |\n"
        md = md + "| Throughput | " + string(this.casesPerSec) + " cases/sec |\n"
        md = md + "\n"

        if (this.dimensions.length > 0) {
            md = md + "## Dimensions\n\n"
            md = md + "| Dimension | Avg Score | Pass Rate | Threshold |\n|---|---|---|---|\n"
            for (var i: int = 0; i < this.dimensions.length; i = i + 1) {
                var d: any = this.dimensions[i]
                md = md + "| " + d.name + " | " + string(d.avgScore) + " | " + string(d.passRate) + "% | " + string(d.threshold) + " |\n"
            }
            md = md + "\n"
        }

        return md
    }

    // toHTML writes an HTML report to a file
    async toHTML(filepath: string): Task<any> {
        var html: string = "<!DOCTYPE html><html><head><meta charset='utf-8'>"
        html = html + "<title>Evaluation Report</title>"
        html = html + "<style>"
        html = html + "body{font-family:system-ui,sans-serif;max-width:900px;margin:40px auto;padding:0 20px;color:#333;}"
        html = html + "h1{color:#1a73e8;}table{border-collapse:collapse;width:100%;margin:20px 0;}"
        html = html + "th,td{border:1px solid #ddd;padding:8px 12px;text-align:left;}"
        html = html + "th{background:#f5f5f5;font-weight:600;}"
        html = html + "tr:nth-child(even){background:#fafafa;}"
        html = html + ".pass{color:#34a853;font-weight:600;}.fail{color:#ea4335;font-weight:600;}"
        html = html + ".metric{font-size:2em;font-weight:700;color:#1a73e8;}"
        html = html + ".grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:20px 0;}"
        html = html + ".card{background:#f8f9fa;border-radius:8px;padding:16px;text-align:center;}"
        html = html + ".card .label{font-size:0.85em;color:#666;}"
        html = html + "</style></head><body>"

        html = html + "<h1>Evaluation Report</h1>"

        // Summary cards
        html = html + "<div class='grid'>"
        html = html + "<div class='card'><div class='metric'>" + string(this.passRate) + "%</div><div class='label'>Pass Rate</div></div>"
        html = html + "<div class='card'><div class='metric'>" + string(this.avgScore) + "</div><div class='label'>Avg Score</div></div>"
        html = html + "<div class='card'><div class='metric'>" + string(this.totalCases) + "</div><div class='label'>Total Cases</div></div>"
        html = html + "<div class='card'><div class='metric'>" + string(this.durationMs) + "ms</div><div class='label'>Duration</div></div>"
        html = html + "</div>"

        // Metrics table
        html = html + "<h2>Metrics</h2><table>"
        html = html + "<tr><th>Metric</th><th>Value</th></tr>"
        html = html + "<tr><td>Passed</td><td>" + string(this.passed) + "</td></tr>"
        html = html + "<tr><td>Failed</td><td>" + string(this.failed) + "</td></tr>"
        html = html + "<tr><td>Median Score</td><td>" + string(this.medianScore) + "</td></tr>"
        html = html + "<tr><td>Std Dev</td><td>" + string(this.stdDev) + "</td></tr>"
        html = html + "<tr><td>Total Tokens</td><td>" + string(this.totalTokens) + "</td></tr>"
        html = html + "<tr><td>Total Cost</td><td>$" + string(this.totalCost) + "</td></tr>"
        html = html + "<tr><td>Throughput</td><td>" + string(this.casesPerSec) + " cases/sec</td></tr>"
        html = html + "</table>"

        // Results table
        html = html + "<h2>Results</h2><table>"
        html = html + "<tr><th>#</th><th>Input</th><th>Score</th><th>Status</th><th>Reasoning</th></tr>"
        for (var i: int = 0; i < this.results.length; i = i + 1) {
            var r: any = this.results[i]
            var statusClass: string = r.passed ? "pass" : "fail"
            var statusText: string = r.passed ? "PASS" : "FAIL"
            var inputPreview: string = r.input
            if (inputPreview.length > 80) {
                inputPreview = inputPreview.substring(0, 80) + "..."
            }
            var reasonPreview: string = r.reasoning
            if (reasonPreview.length > 100) {
                reasonPreview = reasonPreview.substring(0, 100) + "..."
            }
            html = html + "<tr><td>" + string(i + 1) + "</td><td>" + inputPreview + "</td>"
            html = html + "<td>" + string(r.score) + "</td>"
            html = html + "<td class='" + statusClass + "'>" + statusText + "</td>"
            html = html + "<td>" + reasonPreview + "</td></tr>"
        }
        html = html + "</table>"

        html = html + "</body></html>"

        fs.writeFile(filepath, html)
        return null
    }

    // print outputs the report to console with formatting
    print(): void {
        println("")
        println("═══════════════════════════════════════")
        println("EVALUATION REPORT")
        println("═══════════════════════════════════════")
        println("Pass rate:    " + string(this.passRate) + "%")
        println("Avg score:    " + string(this.avgScore))
        println("Median score: " + string(this.medianScore))
        println("Std dev:      " + string(this.stdDev))
        println("Cases:        " + string(this.passed) + "/" + string(this.totalCases) + " passed")
        println("Total tokens: " + string(this.totalTokens))
        println("Total cost:   $" + string(this.totalCost))
        println("Duration:     " + string(this.durationMs) + "ms")
        println("Throughput:   " + string(this.casesPerSec) + " cases/sec")

        if (this.dimensions.length > 0) {
            println("")
            println("DIMENSIONS:")
            for (var i: int = 0; i < this.dimensions.length; i = i + 1) {
                var d: any = this.dimensions[i]
                var status: string = d.passRate >= 70.0 ? "PASS" : "FAIL"
                println("  " + d.name + ": " + string(d.avgScore) + " (" + string(d.passRate) + "% pass) — " + status)
            }
        }
        println("")
    }

    // saveBaseline persists this report as a named baseline
    saveBaseline(name: string): void {
        var dir: string = ".chuks_judge/baselines"
        fs.mkdir(dir)
        var data: any = {
            "name": name,
            "totalCases": this.totalCases,
            "passed": this.passed,
            "failed": this.failed,
            "passRate": this.passRate,
            "avgScore": this.avgScore,
            "medianScore": this.medianScore,
            "results": this.results,
        }
        fs.writeFile(dir + "/" + name + ".json", json.stringify(data))
    }

    // compareToBaseline compares this report against a saved baseline
    compareToBaseline(name: string): RegressionReport {
        var filepath: string = ".chuks_judge/baselines/" + name + ".json"
        if (!fs.exists(filepath)) {
            throw new Error("Baseline '" + name + "' not found at " + filepath)
        }
        var baseData: any = json.parse(fs.readFile(filepath))

        var reg: RegressionReport = new RegressionReport()
        reg.baselineName = name
        reg.passRateDelta = this.passRate - baseData.passRate
        reg.scoreDelta = this.avgScore - baseData.avgScore

        // Build maps of baseline results by id for comparison
        var baseMap: map[string]any = {}
        var baseResults: []any = baseData.results
        for (var i: int = 0; i < baseResults.length; i = i + 1) {
            var br: any = baseResults[i]
            if (br.id != "") {
                baseMap.set(br.id, br)
            }
        }

        for (var j: int = 0; j < this.results.length; j = j + 1) {
            var cr: any = this.results[j]
            if (cr.id == "" || !baseMap.has(cr.id)) {
                continue
            }
            var prev: any = baseMap.get(cr.id)
            if (prev.passed && !cr.passed) {
                reg.regressions.push(cr)
            } else if (!prev.passed && cr.passed) {
                reg.improvements.push(cr)
            } else {
                reg.stable.push(cr)
            }
        }

        reg.isRegression = reg.passRateDelta < -5.0
        return reg
    }
}

// ─── Helper Functions ───────────────────────────────────────────────────────

// computeMedian computes the median of a float array
function computeMedian(scores: []any): float {
    if (scores.length == 0) {
        return 0.0
    }
    var sorted: []any = sortFloats(scores)
    var mid: int = sorted.length / 2
    if (sorted.length % 2 == 0) {
        return (sorted[mid - 1] + sorted[mid]) / 2.0
    }
    return sorted[mid]
}

// computeStdDev computes standard deviation given scores and mean
function computeStdDev(scores: []any, mean: float): float {
    if (scores.length == 0) {
        return 0.0
    }
    var sumSq: float = 0.0
    for (var i: int = 0; i < scores.length; i = i + 1) {
        var diff: float = scores[i] - mean
        sumSq = sumSq + diff * diff
    }
    var variance: float = sumSq / float(scores.length)
    return math.sqrt(variance)
}

// sortFloats returns a sorted copy (ascending) using insertion sort
function sortFloats(arr: []any): []any {
    var sorted: []any = []
    for (var i: int = 0; i < arr.length; i = i + 1) {
        sorted.push(arr[i])
    }
    for (var i: int = 1; i < sorted.length; i = i + 1) {
        var key: float = sorted[i]
        var j: int = i - 1
        while (j >= 0 && sorted[j] > key) {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }
    return sorted
}

// sortByScore sorts results by score (ascending if asc=true)
function sortByScore(results: []any, asc: bool): []any {
    var sorted: []any = []
    for (var i: int = 0; i < results.length; i = i + 1) {
        sorted.push(results[i])
    }
    for (var i: int = 1; i < sorted.length; i = i + 1) {
        var key: any = sorted[i]
        var keyScore: float = key.score
        var j: int = i - 1
        if (asc) {
            while (j >= 0 && sorted[j].score > keyScore) {
                sorted[j + 1] = sorted[j]
                j = j - 1
            }
        } else {
            while (j >= 0 && sorted[j].score < keyScore) {
                sorted[j + 1] = sorted[j]
                j = j - 1
            }
        }
        sorted[j + 1] = key
    }
    return sorted
}
