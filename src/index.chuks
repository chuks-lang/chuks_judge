const judge = new Judge()

export {
    judge,
    Judge,
    Evaluator,
    EvalReport,
    RegressionReport,
    ComparisonReport,
    EvalCase,
    EvalResult,
    DimScore,
    DimensionConfig,
    FewShotExample,
    PairwiseCase,
    PairwiseResult,
    ConversationTurn,
    ConversationCase,
    EvalBatch,
    EvalError
}
